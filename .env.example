# ---- Hedera (para + denetim izi) ----
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_TREASURY_ID=
HEDERA_TREASURY_KEY=
HCS_TOPIC_ID=
BLOCKY402_FACILITATOR_URL=https://api.testnet.blocky402.com
# Facilitator cagri zaman asimi. Kutuphane varsayilani 10sn, yavas hatta yetmiyor.
FACILITATOR_TIMEOUT_MS=30000

# Hesap kurulumu (scripts/setup-hedera-accounts.ts) — opsiyonel, varsayilanlari var
TREASURY_FUND_HBAR=100
AGENT_FUND_HBAR=10

# ---- The Graph (kanit katmani) ----
# mode: x402 | apikey
#   apikey  gelistirme modu. Studio key ucretsiz: thegraph.com/studio
#   x402    API key yok, sorgu basina odeme. DIKKAT: testnet gateway deploy
#           edilmemis (ADIM 3), yani x402 = Base MAINNET, sorgu basina ~$0.01
#           gercek USDC. Demo icin; gelistirme icin degil.
GRAPH_GATEWAY_MODE=apikey
GRAPH_GATEWAY_URL=
# Base uzerinde USDC imzalayan Ethereum anahtari: 0x + 64 hex. Hedera anahtari DEGIL.
GRAPH_X402_PRIVATE_KEY=
# base | base-sepolia — bos birakilirsa base
GRAPH_X402_CHAIN=
GRAPH_API_KEY=
# Sorulan protokol ve karsilastirma akranlari (ADIM 19). Messari standardize
# deployment id'leri; hangilerinin standarda uydugu gateway'e sorulmadan
# dogrulanamaz, o yuzden sabit degil konfigurasyon.
GRAPH_SUBJECT_SUBGRAPH=
GRAPH_PEER_SUBGRAPHS=
GRAPH_BRIDGE_SUBGRAPH=

# ---- ENS (agent kimligi, Sepolia) ----
SEPOLIA_RPC_URL=
SEPOLIA_PRIVATE_KEY=
ENS_PARENT_NAME=
ENS_USER_REGISTRY_ADDRESS=

# ---- LLM ----
# Agent muhakemesi. PLAN.md claude-sonnet-5 diyordu, Anthropic anahtari
# olmadigi icin bu surum OpenAI kullaniyor; kodun okudugu degisken bu.
# Bos birakilirsa `pnpm agents` ve `pnpm scenarios --real` calismaz;
# `pnpm agents --offline` stub modelle yine calisir.
OPENAI_API_KEY=
# Opsiyonel, varsayilan gpt-4o-mini
OPENAI_MODEL=

# ---- Protokol parametreleri (PLAN.md Bolum 4) ----
AGENT_COUNT=20
MARKET_K=3
MARKET_T=5
MARKET_ALPHA=0.125
MARKET_EPSILON=0.01

# Market acildiktan sonra havuz dolsa bile bonding en az bu kadar acik kalir.
# Disaridan bir agent'in markete girebilmesi icin var; 0 yaparsan havuz dolar
# dolmaz kosuyor ve pratikte yalniz bizim filomuz girebiliyor.
MIN_BONDING_WINDOW_MS=45000

# ---- Tarayici cuzdani (odeme icin) ----
# WalletConnect / Reown proje kimligi. reown.com uzerinden ucretsiz alinir.
# Cuzdan eslesmesi onlarin relay'i uzerinden gittigi icin zorunlu: bu bos
# birakilirsa 'Connect wallet' butonu neden calismadigini soyleyip durur.
# VITE_ onekli, cunku tarayici bundle'ina girer — gizli bir deger degildir.
VITE_WALLETCONNECT_PROJECT_ID=
