{
  "name": "ethonline",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build && tsc -p tsconfig.scripts.json",
    "typecheck": "pnpm -r build && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "kcalc": "tsx scripts/kcalc.ts",
    "check:hedera": "tsx scripts/check-hedera.ts",
    "setup:hedera": "tsx scripts/setup-hedera-accounts.ts",
    "check:accounts": "tsx scripts/check-accounts.ts",
    "check:hcs": "tsx scripts/check-hcs.ts",
    "check:randomness": "tsx scripts/check-randomness.ts",
    "api": "tsx apps/api/src/server.ts",
    "check:api": "tsx scripts/check-api.ts",
    "check:orchestrator": "tsx scripts/check-orchestrator.ts",
    "check:graph": "tsx scripts/check-graph.ts",
    "demo": "tsx scripts/demo-server.ts",
    "agents": "tsx scripts/agent-fleet.ts",
    "check:resolve": "tsx scripts/check-resolve.ts",
    "scenarios": "tsx scripts/demo-scenarios.ts",
    "ens:parent": "tsx scripts/ens-parent.ts",
    "ens:registry": "tsx scripts/ens-registry.ts",
    "ens:spike": "tsx scripts/ens-spike.ts",
    "ens:mint": "tsx scripts/ens-mint.ts",
    "ens:score": "tsx scripts/ens-score.ts",
    "ens:read": "tsx scripts/ens-read.ts",
    "start:all": "tsx scripts/start-all.ts",
    "start": "tsx scripts/start-all.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "dotenv": "^17.4.2",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@ethonline/agent": "workspace:*",
    "@ethonline/api": "workspace:*",
    "@ethonline/core": "workspace:*",
    "@ethonline/env": "workspace:*",
    "@ethonline/graph": "workspace:*",
    "@ethonline/hedera": "workspace:*",
    "@hashgraph/sdk": "^2.81.0",
    "@x402/fetch": "^2.25.0",
    "@x402/hedera": "^2.25.0",
    "express": "^5.2.1",
    "viem": "2.56.3",
    "@ethonline/ens": "workspace:*"
  }
}
